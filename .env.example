# ─────────────────────────────────────────────────────────────────────────────
# AI Persona — environment variable template
# Copy to .env and fill in every non-optional value before running.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM (Groq) ───────────────────────────────────────────────────────────────
# Use a Groq chat model ID, e.g. llama-3.1-8b-instant or llama-3.1-70b-versatile
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
LLM_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=

# ── Embeddings ───────────────────────────────────────────────────────────────
# Local SentenceTransformers (default, zero-cost, no API key needed).
# The model is downloaded once and cached in ~/.cache/huggingface/
# Provider options: local (default) | openai | groq
# Only required when EMBEDDING_PROVIDER=openai/groq
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
OPENAI_API_KEY=

# ── Voice platform (Vapi) ────────────────────────────────────────────────────
VAPI_API_KEY=
# Set these AFTER running:  cd packages/voice && python setup_vapi.py
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
 
# ── Text-to-speech (ElevenLabs, used by Vapi) ────────────────────────────────
# Vapi uses this key internally to call ElevenLabs on your behalf.
# Add your ElevenLabs API key to your Vapi dashboard, or set it here if your
# Vapi integration reads it as an env var.
ELEVENLABS_API_KEY=

# ── Telephony (Twilio — optional) ────────────────────────────────────────────
# Only needed if using:  python setup_vapi.py --use-twilio
# Leave blank to use a Vapi-managed number instead (default).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ── Google Calendar + Gmail ───────────────────────────────────────────────────
# Step 1: create an OAuth2 client in Google Cloud Console
#   → APIs & Services → Credentials → OAuth 2.0 Client IDs (Desktop app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Step 2: run the one-time auth flow to get a token (see calendar_service.py)
#   python packages/persona-api/calendar_service.py --setup
# Then paste the resulting single-line JSON string here:
GOOGLE_CREDENTIALS_JSON=

GOOGLE_CALENDAR_ID=primary
# Your Gmail address — used as sender for booking confirmation emails
OWNER_EMAIL=

# ── GitHub ingestion ──────────────────────────────────────────────────────────
# Personal access token (read-only scope is enough).
# Without this the ingest pipeline is limited to 60 API requests/hour.
GITHUB_TOKEN=

# ── Persona identity ──────────────────────────────────────────────────────────
PERSONA_NAME=Soumya Singh
RESUME_PATH=./data/My_Resume.pdf

# ── Vector store (ChromaDB) ───────────────────────────────────────────────────
# Path inside the container; the host directory ./chroma_db is bind-mounted here.
CHROMA_PERSIST_DIR=/app/chroma_db
CHROMA_COLLECTION=persona

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origins, or * to allow all (fine for local dev).
ALLOWED_ORIGINS=*

# ── Service URLs ──────────────────────────────────────────────────────────────
# Used inside the Docker network (container-to-container)
PERSONA_API_URL=http://persona-api:8000

# Used by the browser (must be publicly reachable in production)
NEXT_PUBLIC_PERSONA_API_URL=http://localhost:8000

# ── Eval / logging ────────────────────────────────────────────────────────────
# JSONL file written by voice_webhook.py after each call; read by eval scripts.
CALL_LOG_PATH=/tmp/call_log.jsonl

# Phone number to call when running eval_voice_latency.py in live mode.
# Format: E.164, e.g. +15551234567
EVAL_TEST_PHONE_NUMBER=
